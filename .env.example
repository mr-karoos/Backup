# ==============================================================================
# Backup Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets to Git.

# Application Environment (development, test, staging, production)
APP_ENV=development

# HTTP Server Listen Address
HTTP_ADDR=:8080

# PostgreSQL Connection URL
# Production must provide a dedicated credentials URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backup_platform?sslmode=disable

# Structured Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Storage Root Directory (outside web root, default: /srv/backup-platform)
STORAGE_ROOT=/srv/backup-platform

# JWT Access Token Secret Key (Required, minimum 32 bytes/characters for HS256)
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=

# AES-256-GCM Credential Master Key.
# Required in all environments. Generate a fresh 32-byte key with:
# openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Current encryption key version (positive integer, default: 1).
# Increment only as part of a controlled key-rotation procedure.
ENCRYPTION_MASTER_KEY_VERSION=1

# Refresh Cookie Security (true for HTTPS in staging/production, false for local dev/test HTTP)
AUTH_COOKIE_SECURE=false

# Initial Bootstrap Credentials (Optional, used on first startup to initialize System Admin & Internal Organization)
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change_this_super_secret_password
