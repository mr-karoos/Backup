[Unit]
Description=Backup Platform PostgreSQL Metadata Backup
Documentation=file:///usr/local/share/doc/backup-platform/DEPLOYMENT_INTERNAL_V1.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/backup-platform-metadata-backup
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
