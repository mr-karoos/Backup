[Unit]
Description=Backup Platform PostgreSQL Metadata Backup
Documentation=https://github.com/mr-karoos/Backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/backup-platform-metadata-backup
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
