# ==============================================================================
# Backup Platform - Production & Internal Deployment Environment Example
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `deploy/.env`:
#      cp deploy/.env.example deploy/.env
# 2. Restrict file permissions immediately:
#      chmod 600 deploy/.env
# 3. Fill in the required cryptographic secrets generated using openssl.
# 4. NEVER commit `deploy/.env` or any real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Network & Storage Bindings
# ------------------------------------------------------------------------------
# Host IP binding for the application HTTP port.
# Default: 127.0.0.1 (Localhost only, accessible via SSH Tunnel or local reverse proxy).
# WARNING: NEVER set to 0.0.0.0 on an Internet-facing server without TLS!
BACKUP_PLATFORM_BIND_IP=127.0.0.1

# Host port mapped to the internal container port 8080.
BACKUP_PLATFORM_PORT=8080

# Host directory for persistent backup storage (artifacts, temp directory).
# Default: /srv/backup-platform (Must be prepared using deploy/scripts/prepare-host.sh)
BACKUP_PLATFORM_STORAGE_PATH=/srv/backup-platform

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database name and service account username
POSTGRES_DB=backup_platform
POSTGRES_USER=backup_platform

# High-entropy database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Full PostgreSQL connection URL used by the application container.
# Must target the Compose service hostname 'postgres' (port 5432).
# Format: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable
DATABASE_URL=postgres://backup_platform:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/backup_platform?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Application Runtime & Logging
# ------------------------------------------------------------------------------
# Environment mode (development, staging, production).
# NOTE for Internal V1 without TLS (e.g. SSH Tunnel / VPN access):
# Set APP_ENV=development and AUTH_COOKIE_SECURE=false to allow HTTP session cookies on localhost.
# When Production TLS is introduced later via Reverse Proxy:
# Set APP_ENV=production and AUTH_COOKIE_SECURE=true.
APP_ENV=development

# Structured logging level: debug, info, warn, error
LOG_LEVEL=info

# Cookie Security Flag:
# Set to 'false' for Internal V1 HTTP over SSH tunnel / localhost.
# Set to 'true' for HTTPS / TLS production deployments.
AUTH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 4. Cryptographic Secrets (Mandatory)
# ------------------------------------------------------------------------------
# JWT Access Token Signing Secret (Minimum 32 bytes required for HS256).
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# AES-256-GCM Master Key for encrypting external connection credentials (SSH keys, API tokens).
# Must decode to EXACTLY 32 bytes (256 bits).
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Master key version (Positive integer, default: 1).
ENCRYPTION_MASTER_KEY_VERSION=1

# AES-256-GCM Artifact Encryption Master Key (Direct Stream BPAE & future engines).
# Must decode to EXACTLY 32 bytes (256 bits).
# Generate with: openssl rand -base64 32
# Do NOT reuse ENCRYPTION_MASTER_KEY.
ARTIFACT_ENCRYPTION_MASTER_KEY=

# Artifact master key version (Positive integer, default: 1).
ARTIFACT_ENCRYPTION_MASTER_KEY_VERSION=1

# ------------------------------------------------------------------------------
# 5. Bootstrap Initial System Administrator (Optional / First Startup)
# ------------------------------------------------------------------------------
# If specified, initializes the initial System Admin account and Internal Organization.
# Clear or leave passwords empty after initial platform bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
